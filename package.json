{
  "name": "litedaw",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "LiteDAW \u2014 avionics-inspired ear trainer and mini DAW for desktop and Android",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "preview": "vite preview",
    "cap:sync": "npm run build && cap sync android",
    "cap:open": "cap open android",
    "cap:build": "npm run build && cap sync android && cd android && ./gradlew assembleDebug",
    "smoke": "node scripts/smoke.mjs",
    "verify:fixes": "node scripts/verify-fixes.mjs",
    "icons": "node scripts/gen-icons.mjs",
    "fonts": "node scripts/fetch-fonts.mjs",
    "check:deployed": "node scripts/check-deployed.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@mediabunny/aac-encoder": "^1.58.0",
    "@mediabunny/flac-encoder": "^1.58.0",
    "@mediabunny/mp3-encoder": "^1.58.0",
    "mediabunny": "^1.58.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zustand": "^5.0.15"
  },
  "allowScripts": {
    "esbuild": true,
    "@capacitor/cli": true,
    "sharp": true,
    "workbox-build": true,
    "@thednp/dommatrix": true,
    "fsevents": true
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.1",
    "playwright-core": "^1.63.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0"
  }
}
